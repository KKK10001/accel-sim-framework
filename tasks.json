  "version": "2.0.0",
  "tasks": [
    {
      "label": "Launch Valgrind",
      "type": "shell",
      "command": "valgrind",
      "args": [
          "--vgdb=yes",
          "--vgdb-error=0",
          "--leak-check=full",
          "--show-leak-kinds=all",
          "--track-origins=yes",
          "-s",
          "~/dev/accel-sim/accel-sim-framework/gpu-simulator/bin/debug/accel-sim.out",
          "-config",
          "./gpgpusim.config",
          "-trace",
          "./traces/kernelslist.g",
          "-trace_enabled",
          "1",
          "-trace_components",
          "MEM_STALL_GLOBAL,MEM_STALL_DETAIL,MEM_STALL_GLOBAL_END,L1D_ACCESS, CACHE_MISS",
          "-trace_sampling_core",
          "-1",
          "-trace_output_file",
          "./trace.out"
      ],
      "group": "build",
      "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
